import Mathlib.AlgebraicTopology.Quasicategory.InnerFibration
import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Basic
import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Basic
import SimplicialHomotopy.Fibration.LeftFibrations

/-!
# Right fibrations and right anodyne extensions

Mirrors `SimplicialHomotopy.Fibration.LeftFibrations` (and through it
`Mathlib.AlgebraicTopology.Quasicategory.InnerFibration` and
`Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Basic`),
replacing inner horns `Λ[n, i]` (`0 < i < n`) by right horns (`0 < i`).

* `SSet.rightHornInclusions` : the horn inclusions `Λ[n, i].ι` with `0 < i` (`n ≥ 1`).
* `SSet.rightFibrations` : morphisms with the right lifting property w.r.t. right horn
  inclusions ([Lur09, 2.0.0.3], Kerodon Definition 4.2.1.1, Tag 00T9).
* `SSet.rightAnodyneExtensions` : the left lifting property class of `rightFibrations`
  ([Lur09, 2.0.0.3]).

Inner horns are right horns and right horns are horns, so
`kanFibrations ≤ rightFibrations ≤ innerFibrations`.

Two further sections compare the two one-sided notions: inner horns are the horns which
are both left and right (`SSet.innerHornInclusions_le_leftHornInclusions_inf_rightHornInclusions`),
every horn is left or right (`SSet.leftHornInclusions_sup_rightHornInclusions_eq_J`, whence
`SSet.fibrations_eq_leftFibrations_inf_rightFibrations`), and the covariant involution
`X ↦ X.op` exchanges the two notions (`SSet.rightFibrations_opFunctor_map_iff`).

Everything here is in `MorphismProperty` style so that the small object argument and the
pushout-product machinery of Mathlib apply verbatim.
-/

universe u

open CategoryTheory HomotopicalAlgebra MorphismProperty

open scoped Simplicial SSet.modelCategoryQuillen

namespace SSet

/-- The family of right horn inclusions `Λ[n + 1, i].ι : Λ[n + 1, i] ⟶ Δ[n + 1]`
with `0 < i`. -/
inductive rightHornInclusions : MorphismProperty SSet.{u} where
  | intro {n : ℕ} (i : Fin (n + 2)) (hn : 0 < i) :
    rightHornInclusions Λ[n + 1, i].ι

lemma horn_ι_mem_rightHornInclusions {n : ℕ} {i : Fin (n + 1)}
    (hn : 0 < i) : rightHornInclusions (horn.{u} n i).ι := by
  obtain _ | k := n
  · exact absurd hn (by simp)
  · exact ⟨i, hn⟩

lemma innerHornInclusions_le_rightHornInclusions :
    innerHornInclusions.{u} ≤ rightHornInclusions := by
  rintro _ _ _ ⟨i, h0, _⟩
  exact ⟨i, h0⟩

lemma rightHornInclusions_le_J : rightHornInclusions.{u} ≤ modelCategoryQuillen.J :=
  fun _ _ _ ⟨_, _⟩ ↦ modelCategoryQuillen.horn_ι_mem_J ..

lemma rightHornInclusions_le_monomorphisms :
    rightHornInclusions.{u} ≤ monomorphisms SSet :=
  rightHornInclusions_le_J.trans modelCategoryQuillen.J_le_monomorphisms

/-- Right fibrations: morphisms having the right lifting property with respect to
right horn inclusions ([Lur09, Definition 2.0.0.3]). -/
def rightFibrations : MorphismProperty SSet.{u} := rightHornInclusions.rlp
deriving IsMultiplicative, RespectsIso, IsStableUnderBaseChange,
  IsStableUnderRetracts

/-- A morphism `q` satisfies `[RightFibration q]` if it belongs to `rightFibrations`. -/
@[mk_iff]
class RightFibration {X Y : SSet.{u}} (q : X ⟶ Y) : Prop where
  mem : rightFibrations q

lemma mem_rightFibrations {X Y : SSet.{u}} (q : X ⟶ Y) [RightFibration q] :
    rightFibrations q := RightFibration.mem

/-- A right fibration is an inner fibration. -/
lemma rightFibrations_le_innerFibrations :
    rightFibrations.{u} ≤ innerFibrations :=
  antitone_rlp innerHornInclusions_le_rightHornInclusions

instance {X Y : SSet.{u}} (q : X ⟶ Y) [RightFibration q] : InnerFibration q :=
  ⟨rightFibrations_le_innerFibrations _ (mem_rightFibrations q)⟩

/-- A Kan fibration is a right fibration. -/
lemma fibrations_le_rightFibrations :
    fibrations SSet.{u} ≤ rightFibrations := by
  rw [modelCategoryQuillen.fibrations_eq]
  exact antitone_rlp rightHornInclusions_le_J

instance {X Y : SSet.{u}} (q : X ⟶ Y) [Fibration q] : RightFibration q :=
  ⟨fibrations_le_rightFibrations _ (mem_fibrations q)⟩

/-- The right anodyne extensions: morphisms having the left lifting property with
respect to right fibrations ([Lur09, 2.0.0.3]). By the small object argument this is the
saturated class generated by right horn inclusions. -/
def rightAnodyneExtensions : MorphismProperty SSet.{u} := rightFibrations.llp

lemma rightAnodyneExtensions.horn_ι {n : ℕ} {i : Fin (n + 1)} (hn : 0 < i) :
    rightAnodyneExtensions (horn.{u} n i).ι :=
  le_llp_rlp _ _ (horn_ι_mem_rightHornInclusions hn)

/-- Right anodyne extensions are anodyne extensions. -/
lemma rightAnodyneExtensions_le_anodyneExtensions :
    rightAnodyneExtensions.{u} ≤ anodyneExtensions :=
  antitone_llp fibrations_le_rightFibrations

/-- Inner anodyne extensions are right anodyne extensions. -/
lemma innerAnodyneExtensions_le_rightAnodyneExtensions :
    innerAnodyneExtensions.{u} ≤ rightAnodyneExtensions :=
  antitone_llp rightFibrations_le_innerFibrations

/-! ### Relation to left fibrations

Inner horns are exactly the horns which are simultaneously left horns and right horns:
the inner condition on `i : Fin (n + 2)` is `0 < i ∧ i < Fin.last (n + 1)`. Only the
inclusion `innerHornInclusions ≤ leftHornInclusions ⊓ rightHornInclusions` can be stated
as a comparison of morphism properties: the reverse inclusion would require the
injectivity of `fun (n, i) ↦ Λ[n, i].ι` (from `Λ[n + 1, i].ι = Λ[m + 1, j].ι` one has to
recover `n = m` and `i = j`), which is not available at this Mathlib pin — dependent
elimination on `rightHornInclusions Λ[n + 1, i].ι` fails for exactly that reason.

At the level of the fibration classes, `⊓` behaves the other way round: since `rlp`
turns `⊔` into `⊓`, and since every horn is a left horn or a right horn, a morphism is a
Kan fibration iff it is both a left fibration and a right fibration
([Lur09, Remark 2.0.0.5]). -/

lemma innerHornInclusions_le_leftHornInclusions_inf_rightHornInclusions :
    innerHornInclusions.{u} ≤ leftHornInclusions ⊓ rightHornInclusions := by
  rintro _ _ _ ⟨i, h0, hn⟩
  exact ⟨⟨i, hn⟩, ⟨i, h0⟩⟩

/-- A morphism which has the right lifting property with respect to the horn inclusions
that are both left and right is an inner fibration. -/
lemma inf_rlp_le_innerFibrations :
    (leftHornInclusions.{u} ⊓ rightHornInclusions).rlp ≤ innerFibrations :=
  antitone_rlp innerHornInclusions_le_leftHornInclusions_inf_rightHornInclusions

/-- Every horn inclusion is a left horn inclusion or a right horn inclusion. -/
lemma leftHornInclusions_sup_rightHornInclusions_eq_J :
    leftHornInclusions.{u} ⊔ rightHornInclusions = modelCategoryQuillen.J := by
  refine le_antisymm (sup_le leftHornInclusions_le_J rightHornInclusions_le_J) ?_
  rintro _ _ _ h
  simp only [modelCategoryQuillen.J, iSup_iff] at h
  obtain ⟨n, ⟨i⟩⟩ := h
  rcases lt_or_ge i (Fin.last (n + 1)) with hi | hi
  · exact Or.inl ⟨i, hi⟩
  · exact Or.inr ⟨i, lt_of_lt_of_le Fin.last_pos hi⟩

/-- A morphism is a Kan fibration iff it is both a left fibration and a right fibration. -/
lemma fibrations_eq_leftFibrations_inf_rightFibrations :
    fibrations SSet.{u} = leftFibrations ⊓ rightFibrations := by
  rw [modelCategoryQuillen.fibrations_eq, ← leftHornInclusions_sup_rightHornInclusions_eq_J]
  ext X Y f
  refine ⟨fun h ↦ ⟨fun _ _ _ hi ↦ h _ (Or.inl hi), fun _ _ _ hi ↦ h _ (Or.inr hi)⟩, ?_⟩
  rintro ⟨h₁, h₂⟩ _ _ i (hi | hi)
  · exact h₁ _ hi
  · exact h₂ _ hi

/-! ### Duality: the involution `X ↦ X.op`

The covariant involution `opFunctor : SSet ⥤ SSet` of
`Mathlib.AlgebraicTopology.SimplicialSet.Op` exchanges left and right fibrations. The
identification of `Δ[n].op` with `Δ[n]` (`SSet.stdSimplex.opIso`) carrying `Λ[n, i]` to
`Λ[n, i.rev]` (`SSet.op_horn`) is available at this Mathlib pin, even though the TODO
list of `Mathlib/AlgebraicTopology/SimplicialSet/Op.lean` still announces it as missing. -/

/-- The preimage of a subcomplex along an isomorphism is isomorphic to that subcomplex. -/
def Subcomplex.preimageIso {X Y : SSet.{u}} (A : X.Subcomplex) (e : Y ≅ X) :
    (A.preimage e.hom : SSet.{u}) ≅ (A : SSet.{u}) where
  hom := A.fromPreimage e.hom
  inv := Subcomplex.lift (A.ι ≫ e.inv) (by
    rw [← Subcomplex.image_eq_range, Subcomplex.image_le_iff, ← Subcomplex.preimage_comp,
      e.inv_hom_id, Subcomplex.preimage_id])
  hom_inv_id := by
    rw [← cancel_mono (A.preimage e.hom).ι]
    simp [Subcomplex.fromPreimage_ι_assoc]
  inv_hom_id := by
    rw [← cancel_mono A.ι]
    simp

/-- Via `SSet.stdSimplex.opIso`, the inclusion of the preimage of `Λ[n, i].op`
(which is `Λ[n, i.rev]`, see `SSet.op_horn`) is isomorphic, as an arrow, to the image
of `Λ[n, i].ι` under the involution `opFunctor`. -/
def hornOpArrowIso {n : ℕ} (i : Fin (n + 1)) :
    Arrow.mk ((Λ[n, i].op.preimage (stdSimplex.opIso.{u} ⦋n⦌).inv).ι) ≅
      Arrow.mk (Λ[n, i].op.ι) :=
  Arrow.isoMk (Subcomplex.preimageIso _ (stdSimplex.opIso.{u} ⦋n⦌).symm)
    (stdSimplex.opIso.{u} ⦋n⦌).symm rfl

lemma hasLiftingProperty_horn_op_iff {X Y : SSet.{u}} (f : X ⟶ Y) {n : ℕ} (i : Fin (n + 1)) :
    HasLiftingProperty (Λ[n, i.rev].ι) f ↔
      HasLiftingProperty (Λ[n, i].ι) (opFunctor.map f) := by
  have adj : opFunctor.{u} ⊣ opFunctor.{u} := opEquivalence.toAdjunction
  rw [← adj.hasLiftingProperty_iff, ← op_horn.{u} i]
  exact HasLiftingProperty.iff_of_arrow_iso_left (hornOpArrowIso i) f

/-- For `i : Fin (n + 2)`, the right horn condition on `i.rev` is the left horn condition
on `i`. -/
lemma _root_.Fin.rev_pos_iff_lt_last {n : ℕ} (i : Fin (n + 2)) :
    0 < i.rev ↔ i < Fin.last (n + 1) := by
  rw [← Fin.rev_last, Fin.rev_lt_rev]

/-- A morphism `f` is a left fibration iff `f.op` is a right fibration. -/
lemma rightFibrations_opFunctor_map_iff {X Y : SSet.{u}} (f : X ⟶ Y) :
    rightFibrations (opFunctor.map f) ↔ leftFibrations f := by
  constructor
  · rintro h _ _ _ ⟨j, hj⟩
    have := (hasLiftingProperty_horn_op_iff f j.rev).2
      (h _ ⟨j.rev, (Fin.rev_pos_iff_lt_last j).2 hj⟩)
    rwa [Fin.rev_rev] at this
  · rintro h _ _ _ ⟨i, h0⟩
    rw [← hasLiftingProperty_horn_op_iff]
    exact h _ ⟨i.rev, (Fin.rev_pos_iff_lt_last i.rev).1 (by rwa [Fin.rev_rev])⟩

/-- A morphism `f` is a right fibration iff `f.op` is a left fibration. -/
lemma leftFibrations_opFunctor_map_iff {X Y : SSet.{u}} (f : X ⟶ Y) :
    leftFibrations (opFunctor.map f) ↔ rightFibrations f := by
  constructor
  · rintro h _ _ _ ⟨i, h0⟩
    have := (hasLiftingProperty_horn_op_iff f i.rev).2
      (h _ ⟨i.rev, (Fin.rev_pos_iff_lt_last i.rev).1 (by rwa [Fin.rev_rev])⟩)
    rwa [Fin.rev_rev] at this
  · rintro h _ _ _ ⟨j, hj⟩
    rw [← hasLiftingProperty_horn_op_iff]
    exact h _ ⟨j.rev, (Fin.rev_pos_iff_lt_last j).2 hj⟩

end SSet
