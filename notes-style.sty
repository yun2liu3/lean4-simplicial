% notes-style.sty — the shared style of Claudia's research notes (v2, 2026-10-15).
% Shared file, copied from ~/github/aisystem/templates/research-repo/; edit it there, not here.
% The look is the one of the categorification note for Ben (Palatino, a narrow text block, small-caps
% headings in one accent colour, a bar beside theorems, a washed summary box), with the coloured marks
% of the reading notes. Use (from any folder of the repo):
%   \documentclass[11pt,a4paper]{article}
%   \makeatletter\def\input@path{{./}{../}{../../}{../../../}}\makeatother
%   \usepackage{notes-style}
%   \title{...}\author{Yun Liu}\date{...}
%   \runninghead{Short title}          % optional; the page head, default the title
% Repo-specific macros go in the note (or a repo macro file) after this line.
% Compiles with pdfLaTeX (Palatino via mathpazo) or XeLaTeX/LuaLaTeX (TeX Gyre Pagella).
\NeedsTeXFormat{LaTeX2e}
% (no \ProvidesPackage: the file is found via \input@path, and the name check would warn)

% ---------------------------------------------------------------- page
\RequirePackage[textwidth=33pc,textheight=47\baselineskip,top=1.05in,
                headsep=2.2\baselineskip,footskip=3\baselineskip]{geometry}
\linespread{1.05}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.5em}

% ---------------------------------------------------------------- fonts
\RequirePackage{amsmath,mathtools,amsthm}
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[sc]{mathpazo}
  \RequirePackage{amssymb}
\else
  \RequirePackage{fontspec}
  \RequirePackage[math-style=TeX,bold-style=upright]{unicode-math}
  \setmainfont{TeX Gyre Pagella}[Numbers=Lining,SmallCapsFeatures={LetterSpace=4}]
  \setmathfont{TeX Gyre Pagella Math}
\fi
\RequirePackage[protrusion=true]{microtype}

% ---------------------------------------------------------------- colours
% One accent for structure; the marks of NOTES-GUIDE section 4 each have their own colour.
\RequirePackage{xcolor}
\definecolor{accent}{RGB}{28,64,112}      % headings, theorem heads and bars, links
\definecolor{primary}{RGB}{28,64,112}     % same as accent (TikZ: points, curves)
\definecolor{secondary}{RGB}{190,25,25}   % red: an error, a correction
\definecolor{gapc}{RGB}{170,30,140}       % magenta: a gap filled
\definecolor{qcol}{RGB}{110,50,170}       % violet: an open question
\definecolor{anscol}{RGB}{0,120,140}      % teal: intuition, a checked answer
\definecolor{rule}{RGB}{190,198,210}      % quiet lines, the qed square
\definecolor{wash}{RGB}{244,246,250}      % summary box background
\definecolor{lightgray}{RGB}{220,220,220}
\RequirePackage{tikz-cd}

% ---------------------------------------------------------------- headings and page head
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\scshape}{\textcolor{accent}{\thesection}}{0.8em}{}
\titlespacing*{\section}{0pt}{2\baselineskip}{0.8\baselineskip}
\titleformat{\subsection}{\normalfont\itshape}{\textcolor{accent}{\thesubsection}}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.1\baselineskip}{0.4\baselineskip}
\titleformat{\subsubsection}[runin]{\normalfont\itshape}{\thesubsubsection}{0.5em}{}[.]

\RequirePackage{fancyhdr}
\newcommand{\@runninghead}{{\def\\{ }\let\large\relax\let\Large\relax\let\normalsize\relax\@title}}
\newcommand{\runninghead}[1]{\renewcommand{\@runninghead}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\footnotesize\scshape\color{gray}\@runninghead}
\fancyhead[R]{\footnotesize\color{gray}\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\color{gray}\thepage}}
% Title block, as in the note for Ben: a quiet line "Working note · date", the title in small caps,
% the author, a short rule. \notekind{Meeting notes} changes the first words (default: Working note).
\newcommand{\@notekind}{Working note}
\newcommand{\notekind}[1]{\renewcommand{\@notekind}{#1}}
\renewcommand{\maketitle}{\thispagestyle{plain}%
  \begin{center}
    {\footnotesize\scshape\color{gray}\@notekind\ \textperiodcentered\ \@date\par}\vspace{0.9\baselineskip}
    {\Large\scshape\@title\par}\vspace{0.5\baselineskip}
    {\normalsize\@author\par}\vspace{0.6\baselineskip}
    {\color{rule}\rule{6em}{0.4pt}\par}
  \end{center}\vspace{1.2\baselineskip}}

% ---------------------------------------------------------------- theorems
\RequirePackage{thmtools}
\declaretheoremstyle[headfont=\scshape\color{accent},bodyfont=\normalfont,
  notefont=\normalfont\itshape,notebraces={(}{)},headpunct={.},
  spaceabove=0.7\baselineskip,spacebelow=0.7\baselineskip]{note}
\declaretheoremstyle[headfont=\itshape,bodyfont=\normalfont,headpunct={.},
  spaceabove=0.6\baselineskip,spacebelow=0.6\baselineskip]{aside}
\declaretheorem[style=note,name=Theorem,numberwithin=section]{theorem}
\declaretheorem[style=note,name=Proposition,sibling=theorem]{proposition}
\declaretheorem[style=note,name=Lemma,sibling=theorem]{lemma}
\declaretheorem[style=note,name=Corollary,sibling=theorem]{corollary}
\declaretheorem[style=note,name=Conjecture,sibling=theorem]{conjecture}
\declaretheorem[style=note,name=Definition,sibling=theorem]{definition}
\declaretheorem[style=note,name=Construction,sibling=theorem]{construction}
\declaretheorem[style=note,name=Question,sibling=theorem]{question}
\declaretheorem[style=aside,name=Example,sibling=theorem]{example}
\declaretheorem[style=aside,name=Remark,sibling=theorem]{remark}
\declaretheorem[style=aside,name=Warning,sibling=theorem]{warning}
\declaretheorem[style=aside,name=Computation,sibling=theorem]{computation}
\renewcommand{\qedsymbol}{\textcolor{rule}{\rule{0.5em}{0.5em}}}
\renewenvironment{proof}[1][\proofname]{\par\pushQED{\qed}\normalfont
  \topsep0.4\baselineskip\relax\trivlist\item[\hskip\labelsep\itshape#1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

% ---------------------------------------------------------------- boxes
\RequirePackage[most]{tcolorbox}
\tcolorboxenvironment{theorem}{blanker,breakable,left=0.9em,
  borderline west={1.2pt}{0pt}{accent},before skip=0.9\baselineskip,after skip=0.9\baselineskip}
\tcolorboxenvironment{conjecture}{blanker,breakable,left=0.9em,
  borderline west={1.2pt}{0pt}{qcol},before skip=0.9\baselineskip,after skip=0.9\baselineskip}
% \begin{summarybox}[Decisions] ... \end{summarybox}: at the top of every note (default title Summary).
\newtcolorbox{summarybox}[1][Summary]{enhanced,breakable,colback=wash,colframe=wash,boxrule=0pt,arc=1pt,
  left=1.1em,right=1.1em,top=0.7em,bottom=0.7em,fontupper=\small,
  title={#1.},fonttitle=\small\scshape,coltitle=accent,colbacktitle=wash,attach title to upper={\ }}
% \begin{intuition}[title] ... \end{intuition}: an explanation or a picture added to a statement.
\newtcolorbox{intuition}[1][]{enhanced,breakable,colback=anscol!6,colframe=anscol,coltext=black!85,
  boxrule=0pt,leftrule=1.5pt,arc=0pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
  fonttitle=\small\scshape,coltitle=anscol,colbacktitle=anscol!6,attach title to upper={\ },
  title={Intuition\ifx&#1&\else\ \normalfont(#1)\fi.}}
% Longer marks, as boxes with the colour of their tag: \begin{errornote} / gapnote / opennote.
\newcommand{\@notesmarkbox}[3]{\newtcolorbox{#1}[1][]{enhanced,breakable,colback=#2!5,colframe=#2,
  coltext=black!90,boxrule=0pt,leftrule=1.5pt,arc=0pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
  fonttitle=\small\scshape,coltitle=#2,colbacktitle=#2!5,attach title to upper={\ },
  title={#3\ifx&##1&\else\ \normalfont(##1)\fi.}}}
\@notesmarkbox{errornote}{secondary}{Error}
\@notesmarkbox{gapnote}{gapc}{Gap filled}
\@notesmarkbox{opennote}{qcol}{Open}

% ---------------------------------------------------------------- lists, tables, links
\RequirePackage{booktabs,tabularx,array,longtable}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=1.6em}
\setlist[enumerate]{label=\textup{(\alph*)},leftmargin=2em}
\RequirePackage[font=small,labelfont=sc,labelsep=period,skip=6pt]{caption}
\RequirePackage{needspace}
\numberwithin{equation}{section}
\RequirePackage[colorlinks,linkcolor=accent,citecolor=accent,urlcolor=accent]{hyperref}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\crefname{computation}{Computation}{Computations}
\crefname{construction}{Construction}{Constructions}
\crefname{conjecture}{Conjecture}{Conjectures}
\crefname{question}{Question}{Questions}
\crefname{warning}{Warning}{Warnings}

% ---------------------------------------------------------------- notation
% Number sets (kept if the note defines its own first).
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\C}{\mathbb{C}}

% ---------------------------------------------------------------- marks (NOTES-GUIDE section 4)
\newcommand{\NoteError}{\textsc{\textcolor{secondary}{[error]}}}
\newcommand{\NoteGap}{\textsc{\textcolor{gapc}{[gap]}}}
\newcommand{\NoteOpen}{\textsc{\textcolor{qcol}{[open]}}}
\newcommand{\NoteClaudia}{\textsc{\textcolor{accent}{[for Claudia]}}}
\newcommand{\NoteTentative}{\textit{\textcolor{gray}{(tentative)}}}
% Status line under the title: \NoteStatus{proved | checked in ... | conjecture}.
\newcommand{\NoteStatus}[1]{\par\noindent{\small\scshape\color{accent}Status.}\ #1\par\medskip}
\endinput
