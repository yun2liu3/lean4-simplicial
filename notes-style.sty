% notes-style.sty — the shared style of Claudia's research notes (v2, 2026-10-15).
% Shared file, copied from ~/github/aisystem/templates/research-repo/; edit it there, not here.
% The look is the one of the categorification note for Ben (Palatino, a narrow text block, small-caps
% headings in one accent colour, a bar beside theorems, a washed summary box), with the coloured marks
% of the reading notes. Use (from any folder of the repo):
%   \documentclass[11pt,a4paper]{article}
%   \makeatletter\def\input@path{{./}{../}{../../}{../../../}}\makeatother
%   \usepackage{notes-style}
%   \title{...}\author{Yun Liu}\date{...}
%   \runninghead{Short title}          % optional; the page head, default the title
% Repo-specific macros go in the note (or a repo macro file) after this line.
% Compiles with pdfLaTeX (Palatino via mathpazo) or XeLaTeX/LuaLaTeX (TeX Gyre Pagella).
\NeedsTeXFormat{LaTeX2e}
% (no \ProvidesPackage: the file is found via \input@path, and the name check would warn)
% Loaded once only, and theorem names defined earlier (e.g. by an Overleaf main file) are kept.
\ifdefined\notesstyle@loaded\expandafter\endinput\fi
\def\notesstyle@loaded{}

% ---------------------------------------------------------------- page
\RequirePackage[textwidth=33pc,textheight=47\baselineskip,top=1.05in,
                headsep=2.2\baselineskip,footskip=3\baselineskip]{geometry}
\linespread{1.05}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.5em}

% ---------------------------------------------------------------- fonts
\RequirePackage{amsmath,mathtools,amsthm}
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[sc]{mathpazo}
  \RequirePackage{amssymb}
\else
  \RequirePackage{fontspec}
  \RequirePackage[math-style=TeX,bold-style=upright]{unicode-math}
  \setmainfont{TeX Gyre Pagella}[Numbers=Lining,SmallCapsFeatures={LetterSpace=4}]
  \setmathfont{TeX Gyre Pagella Math}
\fi
\RequirePackage[protrusion=true]{microtype}

% ---------------------------------------------------------------- colours
% One accent for structure; the marks of NOTES-GUIDE section 4 each have their own colour.
\RequirePackage{xcolor}
\definecolor{accent}{RGB}{28,64,112}      % headings, theorem heads and bars, links
\definecolor{primary}{RGB}{28,64,112}     % same as accent (TikZ: points, curves)
\definecolor{secondary}{RGB}{190,25,25}   % red: an error, a correction
\definecolor{gapc}{RGB}{170,30,140}       % magenta: a gap filled
\definecolor{qcol}{RGB}{110,50,170}       % violet: an open question
\definecolor{anscol}{RGB}{0,120,140}      % teal: intuition, a checked answer
\definecolor{rule}{RGB}{190,198,210}      % quiet lines, the qed square
\definecolor{wash}{RGB}{244,246,250}      % summary box background
\definecolor{lightgray}{RGB}{220,220,220}
% Status of a result (notestatus, \NoteTag): one meaning per colour, shared with the marks.
%   proved: provedc; given inputs: givenc; checked: anscol; claimed, not verified: claimc;
%   false: secondary; open: qcol. Definitions in dependency graphs: accent.
\definecolor{provedc}{RGB}{0,125,70}     % green: proved
\definecolor{givenc}{RGB}{196,112,0}     % amber: proved, given named inputs
\definecolor{claimc}{RGB}{105,105,105}   % gray: claimed, not verified
\RequirePackage{tikz-cd}

% ---------------------------------------------------------------- headings and page head
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\scshape}{\textcolor{accent}{\thesection}}{0.8em}{}
\titlespacing*{\section}{0pt}{2\baselineskip}{0.8\baselineskip}
\titleformat{\subsection}{\normalfont\itshape}{\textcolor{accent}{\thesubsection}}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.1\baselineskip}{0.4\baselineskip}
\titleformat{\subsubsection}[runin]{\normalfont\itshape}{\thesubsubsection}{0.5em}{}[.]

\RequirePackage{fancyhdr}
\newcommand{\@runninghead}{{\def\\{ }\let\large\relax\let\Large\relax\let\normalsize\relax\@title}}
\newcommand{\runninghead}[1]{\renewcommand{\@runninghead}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\footnotesize\scshape\color{gray}\@runninghead}
\fancyhead[R]{\footnotesize\color{gray}\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\color{gray}\thepage}}
% Title block, as in the note for Ben: a quiet line "Working note · date", the title in small caps,
% the author, a short rule. \notekind{Meeting notes} changes the first words (default: Working note).
\newcommand{\@notekind}{Working note}
\newcommand{\notekind}[1]{\renewcommand{\@notekind}{#1}}
\renewcommand{\maketitle}{\thispagestyle{plain}%
  \begin{center}
    {\footnotesize\scshape\color{gray}\@notekind\ \textperiodcentered\ \@date\par}\vspace{0.9\baselineskip}
    {\Large\scshape\@title\par}\vspace{0.5\baselineskip}
    {\normalsize\@author\par}\vspace{0.6\baselineskip}
    {\color{rule}\rule{6em}{0.4pt}\par}
  \end{center}\vspace{1.2\baselineskip}}

% ---------------------------------------------------------------- theorems
% amsthm only (thmtools' sibling key made Overleaf define \c@proposition twice); a name defined
% earlier, e.g. by an Overleaf main file, is kept with a warning.
\newtheoremstyle{note}{0.7\baselineskip}{0.7\baselineskip}{\normalfont}{}{\scshape\color{accent}}{.}{ }
  {\thmname{#1}\thmnumber{ #2}\thmnote{ {\normalfont\itshape(#3)}}}
\newtheoremstyle{aside}{0.6\baselineskip}{0.6\baselineskip}{\normalfont}{}{\itshape}{.}{ }{}
\newcommand\notesstyle@kept[1]{\PackageWarningNoLine{notes-style}{`#1' was already defined; the earlier one is kept}}
\newcommand\notesstyle@thm[3]{\@ifundefined{#2}{\@ifundefined{c@#2}%
    {\theoremstyle{#1}\newtheorem{#2}[theorem]{#3}}{\notesstyle@kept{#2}}}{\notesstyle@kept{#2}}}
\@ifundefined{theorem}{\@ifundefined{c@theorem}%
    {\theoremstyle{note}\newtheorem{theorem}{Theorem}[section]}%
    {\let\notesstyle@thethm\thetheorem % a bare counter: number with it; amsthm would make
     \theoremstyle{note}\newtheorem{theorem}[theorem]{Theorem}% \thetheorem call itself,
     \let\thetheorem\notesstyle@thethm}}% so its format is put back
  {\notesstyle@kept{theorem}}
% The siblings below number with the counter `theorem'. An earlier unnumbered theorem
% (\newtheorem*{theorem}) made none, and amsthm would stop with "No counter": make it here.
\@ifundefined{c@theorem}{\newcounter{theorem}[section]%
  \renewcommand{\thetheorem}{\thesection.\arabic{theorem}}}{}
\notesstyle@thm{note}{proposition}{Proposition}
\notesstyle@thm{note}{lemma}{Lemma}
\notesstyle@thm{note}{corollary}{Corollary}
\notesstyle@thm{note}{conjecture}{Conjecture}
\notesstyle@thm{note}{definition}{Definition}
\notesstyle@thm{note}{construction}{Construction}
\notesstyle@thm{note}{question}{Question}
\notesstyle@thm{aside}{example}{Example}
\notesstyle@thm{aside}{remark}{Remark}
\notesstyle@thm{aside}{warning}{Warning}
\notesstyle@thm{aside}{computation}{Computation}
% Internal heads of the status boxes (below): numbered with `theorem', no bar of their own.
\notesstyle@thm{note}{claim}{Claim}
\newtheorem{notesst@theorem}[theorem]{Theorem}
\newtheorem{notesst@proposition}[theorem]{Proposition}
\newtheorem{notesst@lemma}[theorem]{Lemma}
\newtheorem{notesst@corollary}[theorem]{Corollary}
\newtheorem{notesst@conjecture}[theorem]{Conjecture}
\newtheorem{notesst@claim}[theorem]{Claim}
\newtheorem{notesst@question}[theorem]{Question}
\theoremstyle{plain}
\renewcommand{\qedsymbol}{\textcolor{rule}{\rule{0.5em}{0.5em}}}
\renewenvironment{proof}[1][\proofname]{\par\pushQED{\qed}\normalfont
  \topsep0.4\baselineskip\relax\trivlist\item[\hskip\labelsep\itshape#1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

% ---------------------------------------------------------------- boxes
\RequirePackage[most]{tcolorbox}
\tcolorboxenvironment{theorem}{blanker,breakable,left=0.9em,
  borderline west={1.2pt}{0pt}{accent},before skip=0.9\baselineskip,after skip=0.9\baselineskip}
\tcolorboxenvironment{conjecture}{blanker,breakable,left=0.9em,
  borderline west={1.2pt}{0pt}{qcol},before skip=0.9\baselineskip,after skip=0.9\baselineskip}
% \begin{summarybox}[Decisions] ... \end{summarybox}: at the top of every note (default title Summary).
\newtcolorbox{summarybox}[1][Summary]{enhanced,breakable,colback=wash,colframe=wash,boxrule=0pt,arc=1pt,
  left=1.1em,right=1.1em,top=0.7em,bottom=0.7em,fontupper=\small,
  title={#1.},fonttitle=\small\scshape,coltitle=accent,colbacktitle=wash,attach title to upper={\ }}
% The intuition layer (2026-10-23). Statements and proofs are the precise core and always print;
% the layer carries what helps understanding, and the core must read cleanly without it:
%   \begin{intuition}[title] ... \end{intuition}  an explanation or a picture added to a statement
%   \begin{opening} ... \end{opening}             at the start of a chapter or note: the picture first
%   \begin{bridge} ... \end{bridge}               between sections, or connecting results
% \notesprecise in the preamble drops the layer (the precise build); so does building with
%   pdflatex '\def\notesprecisebuild{}\input{main}'
% without touching the file, so both versions come from one source.
\newif\ifnotes@intuition \notes@intuitiontrue
\newcommand{\notesprecise}{\notes@intuitionfalse}
\AtBeginDocument{\ifdefined\notesprecisebuild\notes@intuitionfalse\fi}
\newcommand{\@noteslayerbox}[3]{\newtcolorbox{#1@box}[1][]{enhanced,breakable,colback=#2!6,colframe=#2,
  coltext=black!85,boxrule=0pt,leftrule=1.5pt,arc=0pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
  fonttitle=\small\scshape,coltitle=#2,colbacktitle=#2!6,attach title to upper={\ },
  title={#3\ifx&##1&\else\ \normalfont(##1)\fi.}}%
  % On: the box itself, the body never grabbed (tikzcd and & inside keep working). Off: the body is
  % grabbed and dropped, never typeset. Decided at \begin{document}, after \notesprecise.
  \AtBeginDocument{\ifnotes@intuition
    \NewDocumentEnvironment{#1}{O{}}{\begin{#1@box}[##1]}{\end{#1@box}}%
  \else
    \NewDocumentEnvironment{#1}{O{}+b}{}{}%
  \fi}}
\@noteslayerbox{intuition}{anscol}{Intuition}
\@noteslayerbox{opening}{anscol}{The picture}
\@noteslayerbox{bridge}{anscol}{Where we are}
% Longer marks, as boxes with the colour of their tag: \begin{errornote} / gapnote / opennote.
\newcommand{\@notesmarkbox}[3]{\newtcolorbox{#1}[1][]{enhanced,breakable,colback=#2!5,colframe=#2,
  coltext=black!90,boxrule=0pt,leftrule=1.5pt,arc=0pt,left=6pt,right=6pt,top=3pt,bottom=3pt,
  fonttitle=\small\scshape,coltitle=#2,colbacktitle=#2!5,attach title to upper={\ },
  title={#3\ifx&##1&\else\ \normalfont(##1)\fi.}}}
\@notesmarkbox{errornote}{secondary}{Error}
\@notesmarkbox{gapnote}{gapc}{Gap filled}
\@notesmarkbox{opennote}{qcol}{Open}

% ---------------------------------------------------------------- lists, tables, links
\RequirePackage{booktabs,tabularx,array,longtable}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=1.6em}
\setlist[enumerate]{label=\textup{(\alph*)},leftmargin=2em}
\RequirePackage[font=small,labelfont=sc,labelsep=period,skip=6pt]{caption}
\RequirePackage{needspace}
\numberwithin{equation}{section}
\RequirePackage[colorlinks,linkcolor=accent,citecolor=accent,urlcolor=accent]{hyperref}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\crefname{computation}{Computation}{Computations}
\crefname{construction}{Construction}{Constructions}
\crefname{conjecture}{Conjecture}{Conjectures}
\crefname{question}{Question}{Questions}
\crefname{warning}{Warning}{Warnings}
\crefname{claim}{Claim}{Claims}

% ---------------------------------------------------------------- notation
% Number sets (kept if the note defines its own first).
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\C}{\mathbb{C}}

% ---------------------------------------------------------------- marks (NOTES-GUIDE section 4)
\newcommand{\NoteError}{\textsc{\textcolor{secondary}{[error]}}}
\newcommand{\NoteGap}{\textsc{\textcolor{gapc}{[gap]}}}
\newcommand{\NoteOpen}{\textsc{\textcolor{qcol}{[open]}}}
\newcommand{\NoteClaudia}{\textsc{\textcolor{accent}{[for Claudia]}}}
\newcommand{\NoteTentative}{\textit{\textcolor{gray}{(tentative)}}}
% Status line under the title: \NoteStatus{proved | checked in ... | conjecture}.
\newcommand{\NoteStatus}[1]{\par\noindent{\small\scshape\color{accent}Status.}\ #1\par\medskip}

% ---------------------------------------------------------------- status of results (2026-10-29)
% Every stated result sits in one box that names its status in a word and a colour:
%   \begin{notestatus}{STATUS}{HEAD}[title, source pointer] ... \label{...} ... \end{notestatus}
% STATUS: proved     proved, unconditionally on the stated range        PROVED          green
%         given      proved, given inputs named in the statement        GIVEN INPUTS    amber
%         checked    checked: say in which cases or by which script     CHECKED         teal
%         claimed    claimed or conjectured, not verified               CLAIMED         gray
%         disproved  false: say what is false and the counterexample   FALSE           red
%         open       an open question                                   OPEN            violet
% HEAD: theorem proposition lemma corollary conjecture claim question (numbered with theorem;
% \cref names the head). A result whose parts differ in status is split into consecutive boxes.
% \NoteTag{STATUS}: the same tag inline (tables, summaries). Definitions stay in `definition'.
\newcommand\notes@stdef[4]{\@namedef{notes@stcol@#1}{#2}\@namedef{notes@sttag@#1}{#3}%
  \@namedef{notes@stshort@#1}{#4}}
\notes@stdef{proved}{provedc}{PROVED}{PROVED}
\notes@stdef{given}{givenc}{PROVED, GIVEN INPUTS}{GIVEN INPUTS}
\notes@stdef{checked}{anscol}{CHECKED}{CHECKED}
\notes@stdef{claimed}{claimc}{CLAIMED, NOT VERIFIED}{CLAIMED}
\notes@stdef{disproved}{secondary}{FALSE}{FALSE}
\notes@stdef{open}{qcol}{OPEN}{OPEN}
\newcommand\notes@stcheck[1]{\@ifundefined{notes@stcol@#1}{\PackageError{notes-style}%
  {Unknown status `#1'}{Use proved, given, checked, claimed, disproved or open.}%
  \notes@stdef{#1}{claimc}{UNKNOWN STATUS}{UNKNOWN}}{}}
\newcommand\notes@hdcheck[1]{\@ifundefined{notesst@#1}{\PackageError{notes-style}%
  {Unknown head `#1'}{Use theorem, proposition, lemma, corollary, conjecture, claim or question.}%
  \expandafter\let\csname notesst@#1\endcsname\notesst@claim
  \expandafter\let\csname endnotesst@#1\endcsname\endnotesst@claim}{}}
\newtcolorbox{notes@stbox}[2]{enhanced,breakable,colback=#1!6,colframe=#1,boxrule=0pt,
  leftrule=2.4pt,arc=0pt,left=7pt,right=7pt,top=11pt,bottom=4pt,before skip=0.9\baselineskip,
  after skip=0.9\baselineskip,overlay unbroken and first={\node[anchor=north east,inner sep=2.2pt,
  font=\scriptsize\sffamily\bfseries,text=white,fill=#1] at (frame.north east) {#2};}}
\NewDocumentEnvironment{notestatus}{m m o}
  {\notes@stcheck{#1}\notes@hdcheck{#2}%
   \begin{notes@stbox}{\@nameuse{notes@stcol@#1}}{\@nameuse{notes@sttag@#1}}\crefalias{theorem}{#2}%
   \IfNoValueTF{#3}{\begin{notesst@#2}}{\begin{notesst@#2}[#3]}}
  {\end{notesst@#2}\end{notes@stbox}}
\newcommand{\NoteTag}[1]{\notes@stcheck{#1}{\scriptsize\sffamily\bfseries
  \colorbox{\@nameuse{notes@stcol@#1}}{\textcolor{white}{\@nameuse{notes@stshort@#1}}}}}

% \begin{planbox} ... \end{planbox}: right after \section in a note of several modules: in 4-8
% plain lines, what the section does and why, its objects in order, what it uses from earlier
% sections and what later ones use from it (\cref). Core text: it prints in the precise build.
\newtcolorbox{planbox}[1][Plan of this section]{enhanced,breakable,colback=wash,colframe=accent,
  boxrule=0pt,leftrule=1.5pt,arc=0pt,left=7pt,right=7pt,top=4pt,bottom=4pt,fonttitle=\small\scshape,
  coltitle=accent,colbacktitle=wash,attach title to upper={\ },title={#1.}}

% Dependency graphs (TikZ), one per module: definitions are `dep def' nodes, results `dep=STATUS'
% nodes in their status colour, inputs from earlier sections add `dep earlier', arrows `dep use'
% run from what is used to what uses it. Only these colours.
\tikzset{
  dep def/.style={draw=accent,rectangle,fill=white,align=center,minimum height=.85cm},
  dep/.style={draw=\@nameuse{notes@stcol@#1},fill=\@nameuse{notes@stcol@#1}!12,rounded corners=3pt,
    align=center,minimum height=.85cm},
  dep earlier/.style={dashed},
  dep use/.style={-Stealth,thin,draw=accent}}

% \notefig{fig-name}{caption}{what you are looking at}: a standalone figure (the note loads
% standalone), captioned "Figure N (added): caption" with the line "What you are looking at: ...".
% \notefig* is for a figure taken from a source: "Figure N: caption (source pointer)".
\DeclareCaptionLabelFormat{notesadded}{#1 #2 (added)}
\NewDocumentCommand{\notefig}{s m m m}{\par\medskip\noindent
  \begin{minipage}{\linewidth}\centering
  \ifdefined\includestandalone\includestandalone[mode=tex]{#2}\else
    \PackageError{notes-style}{\string\notefig\space needs \string\usepackage{standalone}}{}\fi\par
  \IfBooleanTF{#1}{\captionsetup{hypcap=false,justification=centering,labelsep=colon}}{\captionsetup{hypcap=false,justification=centering,labelformat=notesadded,labelsep=colon}}%
  \captionof{figure}[#3]{#3\newline \emph{What you are looking at:} #4}\end{minipage}\par\medskip}
\endinput
