import Mathlib.AlgebraicTopology.Quasicategory.InnerFibration
import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Basic
import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Basic

/-!
# Left fibrations and left anodyne extensions

Mirrors `Mathlib.AlgebraicTopology.Quasicategory.InnerFibration` and
`Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Basic`,
replacing inner horns `Λ[n, i]` (`0 < i < n`) by left horns (`i < n`).

* `SSet.leftHornInclusions` : the horn inclusions `Λ[n, i].ι` with `i < n` (`n ≥ 1`).
* `SSet.leftFibrations` : morphisms with the right lifting property w.r.t. left horn
  inclusions ([Lur09, 2.0.0.3], Kerodon Definition 4.2.1.1, Tag 00T9).
* `SSet.leftAnodyneExtensions` : the left lifting property class of `leftFibrations`
  ([Lur09, 2.0.0.3]).

Inner horns are left horns and left horns are horns, so
`kanFibrations ≤ leftFibrations ≤ innerFibrations`.

Everything here is in `MorphismProperty` style so that the small object argument and the
pushout-product machinery of Mathlib apply verbatim.
-/

universe u

open CategoryTheory HomotopicalAlgebra MorphismProperty

open scoped Simplicial SSet.modelCategoryQuillen

namespace SSet

/-- The family of left horn inclusions `Λ[n + 1, i].ι : Λ[n + 1, i] ⟶ Δ[n + 1]`
with `i < Fin.last (n + 1)`. -/
inductive leftHornInclusions : MorphismProperty SSet.{u} where
  | intro {n : ℕ} (i : Fin (n + 2)) (hn : i < Fin.last (n + 1)) :
    leftHornInclusions Λ[n + 1, i].ι

lemma horn_ι_mem_leftHornInclusions {n : ℕ} {i : Fin (n + 1)}
    (hn : i < Fin.last n) : leftHornInclusions (horn.{u} n i).ι := by
  obtain _ | k := n
  · exact absurd hn (by simp)
  · exact ⟨i, hn⟩

lemma innerHornInclusions_le_leftHornInclusions :
    innerHornInclusions.{u} ≤ leftHornInclusions := by
  rintro _ _ _ ⟨i, _, hn⟩
  exact ⟨i, hn⟩

lemma leftHornInclusions_le_J : leftHornInclusions.{u} ≤ modelCategoryQuillen.J :=
  fun _ _ _ ⟨_, _⟩ ↦ modelCategoryQuillen.horn_ι_mem_J ..

lemma leftHornInclusions_le_monomorphisms :
    leftHornInclusions.{u} ≤ monomorphisms SSet :=
  leftHornInclusions_le_J.trans modelCategoryQuillen.J_le_monomorphisms

/-- Left fibrations: morphisms having the right lifting property with respect to
left horn inclusions ([Lur09, Definition 2.0.0.3]). -/
def leftFibrations : MorphismProperty SSet.{u} := leftHornInclusions.rlp
deriving IsMultiplicative, RespectsIso, IsStableUnderBaseChange,
  IsStableUnderRetracts

/-- A morphism `q` satisfies `[LeftFibration q]` if it belongs to `leftFibrations`. -/
@[mk_iff]
class LeftFibration {X Y : SSet.{u}} (q : X ⟶ Y) : Prop where
  mem : leftFibrations q

lemma mem_leftFibrations {X Y : SSet.{u}} (q : X ⟶ Y) [LeftFibration q] :
    leftFibrations q := LeftFibration.mem

/-- A left fibration is an inner fibration. -/
lemma leftFibrations_le_innerFibrations :
    leftFibrations.{u} ≤ innerFibrations :=
  antitone_rlp innerHornInclusions_le_leftHornInclusions

instance {X Y : SSet.{u}} (q : X ⟶ Y) [LeftFibration q] : InnerFibration q :=
  ⟨leftFibrations_le_innerFibrations _ (mem_leftFibrations q)⟩

/-- A Kan fibration is a left fibration. -/
lemma fibrations_le_leftFibrations :
    fibrations SSet.{u} ≤ leftFibrations := by
  rw [modelCategoryQuillen.fibrations_eq]
  exact antitone_rlp leftHornInclusions_le_J

instance {X Y : SSet.{u}} (q : X ⟶ Y) [Fibration q] : LeftFibration q :=
  ⟨fibrations_le_leftFibrations _ (mem_fibrations q)⟩

/-- The left anodyne extensions: morphisms having the left lifting property with
respect to left fibrations ([Lur09, 2.0.0.3]). By the small object argument this is the
saturated class generated by left horn inclusions. -/
def leftAnodyneExtensions : MorphismProperty SSet.{u} := leftFibrations.llp

lemma leftAnodyneExtensions.horn_ι {n : ℕ} {i : Fin (n + 1)} (hn : i < Fin.last n) :
    leftAnodyneExtensions (horn.{u} n i).ι :=
  le_llp_rlp _ _ (horn_ι_mem_leftHornInclusions hn)

/-- Left anodyne extensions are anodyne extensions. -/
lemma leftAnodyneExtensions_le_anodyneExtensions :
    leftAnodyneExtensions.{u} ≤ anodyneExtensions :=
  antitone_llp fibrations_le_leftFibrations

/-- Inner anodyne extensions are left anodyne extensions. -/
lemma innerAnodyneExtensions_le_leftAnodyneExtensions :
    innerAnodyneExtensions.{u} ≤ leftAnodyneExtensions :=
  antitone_llp leftFibrations_le_innerFibrations

end SSet
